# J.A.R.V.I.S. – Konfiguration
# Kopiere diese Datei nach "jarvis/.env" und trage deinen Schlüssel ein.
# Nur ANTHROPIC_API_KEY ist Pflicht, alles andere hat gute Standardwerte.
# Zum Ändern einer Option: "#" am Zeilenanfang entfernen und Wert anpassen.

# ---------------------------------------------------------------
# Pflicht: Claude (console.anthropic.com -> API Keys)
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# Gehirn
# ---------------------------------------------------------------
# JARVIS_MODEL=claude-opus-5-5
# low = schnelle Antworten, medium/high = gründlicheres Nachdenken
# JARVIS_EFFORT=low
# Websuche für aktuelle Infos (ca. 1 Cent pro Suche)
# JARVIS_WEB_SEARCH=true
# Nach so vielen Minuten Pause beginnt ein neues Gespräch
# JARVIS_IDLE_RESET_MINUTES=30

# ---------------------------------------------------------------
# Ort und Sprache
# ---------------------------------------------------------------
# JARVIS_LOCATION=Berlin
# JARVIS_COUNTRY=DE
# JARVIS_TIMEZONE=Europe/Berlin
# JARVIS_LANGUAGE=de

# ---------------------------------------------------------------
# Stimme: edge (kostenlos) | elevenlabs (Premium) | piper (offline) | none
# ---------------------------------------------------------------
# JARVIS_TTS=edge
# JARVIS_EDGE_VOICE=de-DE-FlorianMultilingualNeural
# Sprechtempo, z. B. -5% für ruhiger
# JARVIS_EDGE_RATE=+0%
# Tonhöhe, z. B. -3Hz für tiefer
# JARVIS_EDGE_PITCH=+0Hz

# ElevenLabs (elevenlabs.io -> Profil -> API Keys)
# ELEVENLABS_API_KEY=
# JARVIS_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# JARVIS_ELEVENLABS_MODEL=eleven_multilingual_v2

# Piper (läuft komplett offline, siehe README)
# JARVIS_PIPER_MODEL=~/.jarvis/stimmen/de_DE-thorsten-high.onnx

# ---------------------------------------------------------------
# Spracherkennung: local (kostenlos, privat) | openai
# ---------------------------------------------------------------
# JARVIS_STT=local
# tiny | base | small | medium | large-v3  (größer = genauer, aber langsamer)
# JARVIS_WHISPER_MODEL=small
# OPENAI_API_KEY=
# JARVIS_OPENAI_STT_MODEL=whisper-1
# "Hey Jarvis"-Empfindlichkeit: niedriger = reagiert leichter
# JARVIS_WAKE_THRESHOLD=0.5

# ---------------------------------------------------------------
# Audiogeräte (leer = Systemstandard; Nummer oder Name)
# ---------------------------------------------------------------
# JARVIS_INPUT_DEVICE=
# JARVIS_OUTPUT_DEVICE=

# ---------------------------------------------------------------
# Daten (Aufgaben, Notizen, Gedächtnis, Erinnerungen)
# ---------------------------------------------------------------
# JARVIS_DATA_DIR=~/.jarvis
