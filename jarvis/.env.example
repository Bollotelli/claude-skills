# J.A.R.V.I.S. – Konfiguration
# Kopiere diese Datei nach "jarvis/.env". Ohne Änderungen läuft Jarvis
# komplett kostenlos: lokales Gehirn (Ollama), kostenlose Stimme und Suche.
# Zum Ändern einer Option: "#" am Zeilenanfang entfernen und Wert anpassen.

# ---------------------------------------------------------------
# Gehirn: local (kostenlos, Ollama) | claude (beste Qualität, kostenpflichtig)
# ---------------------------------------------------------------
# JARVIS_BRAIN=local
# Lokales Modell (einmalig laden: ollama pull qwen3:8b)
#   qwen3:4b  für Rechner mit 8 GB RAM
#   qwen3:8b  Standard, ab 16 GB RAM
#   qwen3:14b für starke Rechner (32 GB RAM oder gute Grafikkarte)
# JARVIS_OLLAMA_MODEL=qwen3:8b
# Gedächtnis pro Gespräch in Tokens (mehr braucht mehr RAM)
# JARVIS_OLLAMA_CTX=12288
# Nur nötig, wenn Ollama auf einem anderen Rechner läuft
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------
# Optional, kostenpflichtig: Claude als Gehirn (JARVIS_BRAIN=claude)
# Schlüssel: console.anthropic.com -> API Keys
# ---------------------------------------------------------------
# ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-opus-5-5
# low = schnelle Antworten, medium/high = gründlicheres Nachdenken
# JARVIS_EFFORT=low
# Claudes eigene Websuche (ca. 1 Cent pro Suche)
# JARVIS_WEB_SEARCH=true

# ---------------------------------------------------------------
# Allgemein: Ort, Sprache, Gesprächsdauer
# ---------------------------------------------------------------
# Nach so vielen Minuten Pause beginnt ein neues Gespräch
# JARVIS_IDLE_RESET_MINUTES=30
# JARVIS_LOCATION=Berlin
# JARVIS_COUNTRY=DE
# JARVIS_TIMEZONE=Europe/Berlin
# JARVIS_LANGUAGE=de

# ---------------------------------------------------------------
# Stimme: edge (kostenlos) | piper (kostenlos, offline) | elevenlabs (kostenpflichtig) | none
# ---------------------------------------------------------------
# JARVIS_TTS=edge
# JARVIS_EDGE_VOICE=de-DE-FlorianMultilingualNeural
# Sprechtempo, z. B. -5% für ruhiger
# JARVIS_EDGE_RATE=+0%
# Tonhöhe, z. B. -3Hz für tiefer
# JARVIS_EDGE_PITCH=+0Hz

# ElevenLabs, optional und kostenpflichtig (elevenlabs.io -> Profil -> API Keys)
# ELEVENLABS_API_KEY=
# JARVIS_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# JARVIS_ELEVENLABS_MODEL=eleven_multilingual_v2

# Piper (läuft komplett offline, siehe README)
# JARVIS_PIPER_MODEL=~/.jarvis/stimmen/de_DE-thorsten-high.onnx

# ---------------------------------------------------------------
# Spracherkennung: local (kostenlos, privat) | openai (kostenpflichtig)
# ---------------------------------------------------------------
# JARVIS_STT=local
# tiny | base | small | medium | large-v3  (größer = genauer, aber langsamer)
# JARVIS_WHISPER_MODEL=small
# OPENAI_API_KEY=
# JARVIS_OPENAI_STT_MODEL=whisper-1
# "Hey Jarvis"-Empfindlichkeit: niedriger = reagiert leichter
# JARVIS_WAKE_THRESHOLD=0.5

# ---------------------------------------------------------------
# Audiogeräte (leer = Systemstandard; Nummer oder Name)
# ---------------------------------------------------------------
# JARVIS_INPUT_DEVICE=
# JARVIS_OUTPUT_DEVICE=

# ---------------------------------------------------------------
# Daten (Aufgaben, Notizen, Gedächtnis, Erinnerungen)
# ---------------------------------------------------------------
# JARVIS_DATA_DIR=~/.jarvis
